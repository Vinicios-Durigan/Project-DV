; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project-DV"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

; Resolução base do jogo (GAMEPLAY §2): 640x360, tiles 16x16, personagem 16x32.
window/size/viewport_width=640
window/size/viewport_height=360
; Janela inicial de desenvolvimento: 1280x720 = 640x360 x2, múltiplo inteiro.
; Só muda o tamanho da janela; o viewport interno continua 640x360.
window/size/window_width_override=1280
window/size/window_height_override=720
; O jogo desenha no viewport de 640x360 e a janela apenas amplia o resultado.
window/stretch/mode="viewport"
window/stretch/aspect="keep"
; Escala inteira apenas (x3 = 1080p, x6 = 4K). Zoom não-inteiro é proibido para
; sempre (GAMEPLAY §2): "integer" arredonda a escala para baixo e emoldura a
; sobra, em vez de deformar o pixel.
window/stretch/scale_mode="integer"
; Subjanela vira janela de verdade do sistema operacional, e não um retângulo
; desenhado dentro do viewport de 640x360 — que a recortaria. O padrão do Godot
; 4.7 é `true`; a janela do playground de dev (GAMEPLAY §11) só cabe com este
; `false`.
window/subwindows/embed_subwindows=false

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[input]

; Tela cheia em F11 e Alt+Enter. Quem trata é game/fullscreen_toggle.gd.
toggle_fullscreen={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194342,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":true,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194309,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
; Abre e fecha a janela do playground de dev, em F1 (GAMEPLAY §11). Quem trata é
; game/dev/playground_window.gd.
toggle_playground={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194332,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

; Filtro nearest: pixel art não pode borrar (GAMEPLAY §2).
textures/canvas_textures/default_texture_filter=0
; Pixel snapping do render. Física e câmera seguem em float; só o desenho
; encaixa no pixel (GAMEPLAY §2).
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
