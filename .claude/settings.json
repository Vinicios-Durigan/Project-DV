{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/block-assets-write.sh"],
            "statusMessage": "Verificando escrita em assets/"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/gut-on-sim-change.sh"],
            "timeout": 300,
            "statusMessage": "Rodando suíte GUT"
          }
        ]
      }
    ]
  }
}
